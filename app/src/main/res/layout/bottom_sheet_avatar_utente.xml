<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View style="@style/Widget_PariPari_BottomSheetDragHandle" />

    <!-- Titolo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalizza Avatar"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Scegli un'emoji o la tua iniziale con uno sfondo colorato."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginBottom="16dp" />

    <!-- Anteprima Avatar Live -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_anteprima_avatar"
            android:layout_width="84dp"
            android:layout_height="84dp"
            app:cardCornerRadius="42dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tv_anteprima_emoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="38sp"
                tools:text="🍕" />

            <ImageView
                android:id="@+id/iv_anteprima_foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:importantForAccessibility="no" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_anteprima_etichetta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Anteprima Avatar"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- Scelta Tipo: Emoji vs Iniziale -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chip_group_tipo_avatar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_tipo_emoji"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Emoji" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_tipo_iniziale"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iniziale Nome" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip_tipo_google"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto Google"
            android:visibility="gone" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Selezione Colore di Sfondo -->
    <TextView
        android:id="@+id/tv_label_colore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Colore di sfondo"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:id="@+id/scroll_colori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/container_colori_palette"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

    </HorizontalScrollView>

    <!-- Selezione Emoji (mostrato quando selezionato tab Emoji) -->
    <LinearLayout
        android:id="@+id/layout_sezione_emoji"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Categorie Emoji -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="8dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_categoria_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_persone"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Personaggi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_cibo"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cibo" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_viaggi"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Viaggi" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_svago"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Svago" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_cat_casa"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Casa" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:id="@+id/container_emoji_opzioni"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>
    </LinearLayout>

    <!-- Pulsanti Azione -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_salva_avatar"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Salva Avatar"
        app:cornerRadius="14dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ripristina_avatar"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ripristina iniziale predefinita"
        android:textColor="?attr/colorError"
        app:icon="@drawable/ic_delete"
        app:iconTint="?attr/colorError" />

</LinearLayout>
