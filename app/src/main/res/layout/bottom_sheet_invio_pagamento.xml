<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View style="@style/Widget_PariPari_BottomSheetDragHandle" />

    <!-- Titolo BottomSheet -->
    <TextView
        android:id="@+id/tv_titolo_pagamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titolo_bottom_sheet_pagamento"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Descrizione Trasferimento / Saldo -->
    <TextView
        android:id="@+id/tv_descrizione_saldo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp"
        tools:text="Mario deve dare a Luigi 15.00 EUR" />

    <!-- PULSANTE SEGNA COME GIÀ PAGATO -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_segna_saldato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_segna_saldato"
        android:textAllCaps="false"
        app:backgroundTint="@color/credit_green"
        android:textColor="@android:color/white"
        android:layout_marginBottom="16dp" />

    <!-- CARD PAYPAL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_paypal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/opzione_paypal"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_paypal_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="mario.rossi" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_paypal_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:layout_marginBottom="12dp"
                tools:text="https://paypal.me/mario.rossi/15.00EUR" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_condividi_paypal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_condividi"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copia_paypal"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copia_link"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- CARD REVOLUT -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_revolut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/opzione_revolut"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                    android:textStyle="bold"
                    android:textColor="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tv_revolut_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textColor="?android:attr/textColorSecondary"
                    tools:text="mario123" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_revolut_link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?attr/colorPrimary"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="4dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:layout_marginBottom="12dp"
                tools:text="https://revolut.me/mario123" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_condividi_revolut"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_condividi"
                    android:textAllCaps="false"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_copia_revolut"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copia_link"
                    android:textAllCaps="false" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- AVVISO E BOTTONI GENERICI -->
    <TextView
        android:id="@+id/tv_avviso_non_configurato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/avviso_pagamento_non_configurato"
        android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_condividi_generico"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_condividi"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_vai_profilo"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_vai_al_profilo"
            android:textAllCaps="false" />

    </LinearLayout>

</LinearLayout>
