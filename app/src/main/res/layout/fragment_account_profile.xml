<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_logged_in"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <!-- Avatar Utente Autenticato -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="48dp"
        app:cardElevation="3dp">

        <ImageView
            android:id="@+id/iv_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_account"
            android:padding="20dp"
            android:contentDescription="@string/cd_avatar_utente" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Nome Utente (con opzione modifica al tocco) -->
    <LinearLayout
        android:id="@+id/container_nome_utente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_nome_utente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_nome_utente"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Headline5"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_edit"
            app:tint="?attr/colorPrimary"
            android:contentDescription="@string/dialog_titolo_modifica_nome_profilo" />
    </LinearLayout>

    <!-- Email Utente (con opzione modifica al tocco) -->
    <LinearLayout
        android:id="@+id/container_email_utente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_email_utente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_email_utente"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
            android:textColor="?android:attr/textColorSecondary" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_edit"
            app:tint="?android:attr/textColorSecondary"
            android:contentDescription="@string/cd_modifica_email" />

    </LinearLayout>

    <!-- Pulsante Disconnetti -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_logout"
        android:textAllCaps="false"
        android:layout_marginBottom="12dp" />

    <!-- Riga Verifica Email (stile preferenze, visibile per utenti registrati) -->
    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_top_verifica_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:id="@+id/row_verifica_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:baselineAligned="false"
        android:paddingVertical="14dp"
        android:paddingHorizontal="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_verifica_email"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Pillola Badge stato email (arancione se non verificata, verde se verificata) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_badge_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:cardBackgroundColor="@color/warning_orange_bg"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/iv_badge_email_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_warning_amber"
                    android:layout_marginEnd="6dp"
                    app:tint="@color/warning_orange"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_badge_email_testo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/badge_non_verificata"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Body2"
                    android:textStyle="bold"
                    android:textColor="@color/warning_orange" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider_bottom_verifica_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp" />

</LinearLayout>
