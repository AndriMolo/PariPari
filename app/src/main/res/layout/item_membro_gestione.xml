<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget_PariPari_CardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/avatar_iniziale"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_circle_avatar"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textStyle="bold"
            tools:text="M" />

        <TextView
            android:id="@+id/nome_partecipante"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            tools:text="Marco" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottone_modifica"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/dettaglio_rinomina_partecipante"
            app:icon="@drawable/ic_edit"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottone_elimina"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/dettaglio_elimina_partecipante"
            app:icon="@drawable/ic_delete"
            app:iconTint="?attr/colorError" />

        <!-- MODALITÀ MODIFICA INLINE (VISIBILE SOLO IN EDITING) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_modifica_inline"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:visibility="gone"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_modifica_inline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:paddingVertical="8dp"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottone_salva_inline"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:visibility="gone"
            android:contentDescription="@string/btn_salva"
            app:icon="@drawable/ic_check"
            app:iconTint="?attr/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bottone_annulla_inline"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:visibility="gone"
            android:contentDescription="@string/btn_annulla"
            app:icon="@drawable/ic_close"
            app:iconTint="?attr/colorOutline" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
