<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_spesa"
    style="@style/Widget_PariPari_CardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <!-- Icona spesa -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget_PariPari_CircleIconBadge"
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_spese"
                app:tint="?attr/colorOnPrimaryContainer"
                android:importantForAccessibility="no" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Informazioni Spesa (Titolo e Pagatore/Data) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tv_titolo_spesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="Cena Pizzeria" />

            <TextView
                android:id="@+id/tv_dettaglio_pagatore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="2dp"
                tools:text="Pagato da Io • 9 set" />

        </LinearLayout>

        <!-- Importo e Divisione a destra -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_importo_spesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                tools:text="45,00 EUR" />

            <TextView
                android:id="@+id/tv_info_divisione"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:layout_marginTop="2dp"
                tools:text="Diviso tra 3" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
