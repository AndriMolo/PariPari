rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (matches request.auth.uid)
// Fields:
//   - nome: string (1..100 chars, required)
//   - email: string (valid email format, required)
//   - photoUrl: string (optional, URL format)
//   - createdAt: timestamp (required)
//
// Collection: groups (Schede Spese)
// Document ID: {groupId} (UUID)
// Fields:
//   - titolo: string (1..150 chars, required)
//   - descrizione: string (optional, max 500 chars)
//   - valutaPredefinita: string (3 chars, e.g. "EUR", required)
//   - creatoreId: string (required, creator uid)
//   - dataCreazione: number (timestamp ms, required)
//   - dataAggiornamento: number (timestamp ms, required)
//
// Subcollection: groups/{groupId}/participants/{participantId}
// Fields:
//   - nome: string (1..100 chars, required)
//   - email: string (optional)
//
// Subcollection: groups/{groupId}/expenses/{expenseId}
// Fields:
//   - titolo: string (1..150 chars, required)
//   - importo: number (positive, required)
//   - valuta: string (3 chars, required)
//   - dataSpesa: number (timestamp ms, required)
//   - categoria: string (max 50 chars, required)
//   - pagatoDaId: string (required)
//   - scontrinoUrl: string (optional)
//
// Subcollection: groups/{groupId}/expenses/{expenseId}/shares/{shareId}
// Fields:
//   - partecipanteId: string (required)
//   - quota: number (non-negative, required)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function validString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function validCurrency(val) {
      return val is string && val.size() == 3;
    }

    // ===============================================================
    // Regole Users
    // ===============================================================

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ===============================================================
    // Regole Groups (Schede Spese)
    // ===============================================================

    match /groups/{groupId} {
      allow read: if isAuthenticated() &&
                  (resource.data.creatoreId == request.auth.uid || !('creatoreId' in resource.data));

      allow create: if isAuthenticated() &&
                    request.resource.data.creatoreId == request.auth.uid &&
                    validString(request.resource.data.titolo, 1, 150) &&
                    validCurrency(request.resource.data.valutaPredefinita);

      allow update: if isAuthenticated() &&
                    validString(request.resource.data.titolo, 1, 150);

      allow delete: if isAuthenticated() &&
                    (resource.data.creatoreId == request.auth.uid || !('creatoreId' in resource.data));

      // Sotto-collezione Partecipanti
      match /participants/{participantId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
                              validString(request.resource.data.nome, 1, 100);
        allow delete: if isAuthenticated();
      }

      // Sotto-collezione Spese
      match /expenses/{expenseId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
                              validString(request.resource.data.titolo, 1, 150) &&
                              request.resource.data.importo is number &&
                              request.resource.data.importo > 0;
        allow delete: if isAuthenticated();

        // Sotto-collezione Quote Spesa (Divisioni)
        match /shares/{shareId} {
          allow read: if isAuthenticated();
          allow create, update: if isAuthenticated() &&
                                validString(request.resource.data.partecipanteId, 1, 100) &&
                                request.resource.data.quota is number &&
                                request.resource.data.quota >= 0;
          allow delete: if isAuthenticated();
        }
      }
    }
  }
}
